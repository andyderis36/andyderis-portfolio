rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // --- PRIMITIVES & HELPERS ---
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      // Bootstrap Admin using user's email
      return isSignedIn() && 
             request.auth.token.email == 'andyderis33@gmail.com'; 
    }

    // --- VALIDATION HELPERS ---
    function isValidProfile(data) {
      return data.keys().hasAll(['name', 'jobTitle', 'bio1', 'bio2', 'email', 'github', 'linkedin', 'instagram', 'location', 'updatedAt', 'statusText', 'technicalArsenal', 'contactTitle', 'contactText']) &&
             data.keys().size() == 14 &&
             data.name is string && data.name.size() <= 100 &&
             data.jobTitle is string && data.jobTitle.size() <= 100 &&
             data.bio1 is string && data.bio1.size() <= 2000 &&
             data.bio2 is string && data.bio2.size() <= 2000 &&
             data.email is string && data.email.size() <= 200 &&
             data.github is string && data.github.size() <= 200 &&
             data.linkedin is string && data.linkedin.size() <= 200 &&
             data.instagram is string && data.instagram.size() <= 200 &&
             data.location is string && data.location.size() <= 200 &&
             data.statusText is string && data.statusText.size() <= 200 &&
             data.contactTitle is string && data.contactTitle.size() <= 200 &&
             data.contactText is string && data.contactText.size() <= 2000 &&
             data.technicalArsenal is list &&
             data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'subtitle', 'desc', 'stack', 'link', 'order', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 8 &&
             data.title is string && data.title.size() <= 200 &&
             data.subtitle is string && data.subtitle.size() <= 200 &&
             data.desc is string && data.desc.size() <= 3000 &&
             data.stack is list && data.stack.size() <= 20 && (data.stack.size() == 0 || data.stack[0] is string) &&
             data.link is string && data.link.size() <= 500 &&
             data.order is number &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidExperience(data) {
      return data.keys().hasAll(['role', 'company', 'date', 'location', 'tasks', 'order', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 8 &&
             data.role is string && data.role.size() <= 200 &&
             data.company is string && data.company.size() <= 200 &&
             data.date is string && data.date.size() <= 100 &&
             data.location is string && data.location.size() <= 200 &&
             data.tasks is list && data.tasks.size() <= 20 && (data.tasks.size() == 0 || data.tasks[0] is string) &&
             data.order is number &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidEducation(data) {
      return data.keys().hasAll(['institution', 'degree', 'date', 'location', 'description', 'order', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 8 &&
             data.institution is string && data.institution.size() <= 200 &&
             data.degree is string && data.degree.size() <= 200 &&
             data.date is string && data.date.size() <= 100 &&
             data.location is string && data.location.size() <= 200 &&
             data.description is string && data.description.size() <= 3000 &&
             data.order is number &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['navLogo', 'footerText', 'updatedAt']) &&
             data.keys().size() == 3 &&
             data.navLogo is string && data.navLogo.size() <= 100 &&
             data.footerText is string && data.footerText.size() <= 500 &&
             data.updatedAt is timestamp;
    }

    // --- COLLECTIONS ---

    match /settings/{settingsId} {
      allow get: if isValidId(settingsId);
      allow list: if true;
      
      allow create: if isAdmin() && isValidId(settingsId) && isValidSettings(incoming());
      
      allow update: if isAdmin() && isValidId(settingsId) && isValidSettings(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'navLogo', 'footerText', 'updatedAt'
        ])
      );
      
      allow delete: if isAdmin() && isValidId(settingsId);
    }

    match /profile/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if true; // Publicly readable list (should only be 1 profile anyway)
      
      allow create: if isAdmin() && isValidId(profileId) && isValidProfile(incoming());
      
      allow update: if isAdmin() && isValidId(profileId) && isValidProfile(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'jobTitle', 'bio1', 'bio2', 'email', 'github', 'linkedin', 'instagram', 'location', 'updatedAt', 'statusText', 'technicalArsenal', 'contactTitle', 'contactText'
        ])
      );
      
      allow delete: if isAdmin() && isValidId(profileId);
    }

    match /projects/{projectId} {
      // Publicly readable portofolio content
      allow get: if isValidId(projectId);
      allow list: if true; 

      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) && incoming().createdAt == request.time;
      
      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) && (
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subtitle', 'desc', 'stack', 'link', 'order', 'updatedAt'
        ])
      );
      
      allow delete: if isAdmin() && isValidId(projectId);
    }

    match /experiences/{experienceId} {
      allow get: if isValidId(experienceId);
      allow list: if true;
      
      allow create: if isAdmin() && isValidId(experienceId) && isValidExperience(incoming()) && incoming().createdAt == request.time;
      
      allow update: if isAdmin() && isValidId(experienceId) && isValidExperience(incoming()) && (
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'role', 'company', 'date', 'location', 'tasks', 'order', 'updatedAt'
        ])
      );

      allow delete: if isAdmin() && isValidId(experienceId);
    }

    match /educations/{educationId} {
      allow get: if isValidId(educationId);
      allow list: if true;
      
      allow create: if isAdmin() && isValidId(educationId) && isValidEducation(incoming()) && incoming().createdAt == request.time;
      
      allow update: if isAdmin() && isValidId(educationId) && isValidEducation(incoming()) && (
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'institution', 'degree', 'date', 'location', 'description', 'order', 'updatedAt'
        ])
      );

      allow delete: if isAdmin() && isValidId(educationId);
    }
  }
}
